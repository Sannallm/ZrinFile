<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101113"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="#1A1B1E"
        app:titleTextAppearance="@style/TextAppearance.ZrinFile.ToolbarTitle"
        app:subtitleTextAppearance="@style/TextAppearance.ZrinFile.ToolbarSubtitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/audio_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/audio_cover"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:background="#1D1F23"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/audio_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_audio"
                android:tint="#6F9BD8" />

            <TextView
                android:id="@+id/audio_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#AEB3BB"
                android:textSize="13sp" />

            <ScrollView
                android:id="@+id/audio_lyrics_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <TextView
                    android:id="@+id/audio_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:lineSpacingExtra="7dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="18dp"
                    android:textColor="#8B9098"
                    android:textSize="13sp" />
            </ScrollView>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/media_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#8FB4E8" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1B1E"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <SeekBar
            android:id="@+id/media_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#6F9BD8"
            android:thumbTint="#6F9BD8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/media_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#8B9098"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/media_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_open"
                android:padding="11dp"
                android:src="@drawable/ic_pause"
                android:tint="#E6E7EA" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/media_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#8B9098"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
