<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@drawable/bg_toolbar"
            app:titleTextAppearance="@style/TextAppearance.ZrinFile.ToolbarTitle"
            app:subtitleTextAppearance="@style/TextAppearance.ZrinFile.ToolbarSubtitle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/divider" />

        <HorizontalScrollView
            android:id="@+id/tabs_scroll"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_height"
            android:background="@color/surface"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tab_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <View
            android:id="@+id/tabs_divider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/divider" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/file_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:scrollbarStyle="insideInset" />

            <LinearLayout
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_folder_open"
                    android:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/action_empty"
                    android:textAppearance="@style/TextAppearance.ZrinFile.Body"
                    android:textColor="@color/text_tertiary" />

                <TextView
                    android:id="@+id/empty_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:text="@string/action_go_up"
                    android:textAppearance="@style/TextAppearance.ZrinFile.Body"
                    android:textColor="@color/accent"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="top"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_bar_height"
            android:background="@color/surface"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_new_folder"
                style="@style/Widget.ZrinFile.BottomAction"
                android:contentDescription="@string/action_new_folder">

                <ImageView style="@style/Widget.ZrinFile.BottomIcon" android:src="@drawable/ic_add" />
                <TextView style="@style/Widget.ZrinFile.BottomLabel" android:text="@string/action_new_folder" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_new_file"
                style="@style/Widget.ZrinFile.BottomAction"
                android:contentDescription="@string/action_new_file">

                <ImageView style="@style/Widget.ZrinFile.BottomIcon" android:src="@drawable/ic_file" />
                <TextView style="@style/Widget.ZrinFile.BottomLabel" android:text="@string/action_new_file" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_paste"
                style="@style/Widget.ZrinFile.BottomAction"
                android:contentDescription="@string/action_paste">

                <ImageView style="@style/Widget.ZrinFile.BottomIcon" android:src="@drawable/ic_paste" />
                <TextView style="@style/Widget.ZrinFile.BottomLabel" android:text="@string/action_paste" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_sort"
                style="@style/Widget.ZrinFile.BottomAction"
                android:contentDescription="@string/action_sort">

                <ImageView style="@style/Widget.ZrinFile.BottomIcon" android:src="@drawable/ic_sort" />
                <TextView style="@style/Widget.ZrinFile.BottomLabel" android:text="@string/action_sort" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_view"
                style="@style/Widget.ZrinFile.BottomAction"
                android:contentDescription="视图">

                <ImageView
                    android:id="@+id/btn_view_icon"
                    style="@style/Widget.ZrinFile.BottomIcon"
                    android:src="@drawable/ic_grid" />
                <TextView
                    android:id="@+id/btn_view_label"
                    style="@style/Widget.ZrinFile.BottomLabel"
                    android:text="网格" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.ZrinFile.Title" />

                <TextView
                    android:id="@+id/drawer_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="v1.0.0 · 本地模式"
                    android:textAppearance="@style/TextAppearance.ZrinFile.Caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/root_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="ROOT"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <View style="@style/Widget.ZrinFile.Divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:id="@+id/storage_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ZrinFile.Caption"
                        android:textColor="@color/text_secondary" />

                    <ProgressBar
                        android:id="@+id/storage_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressDrawable="@drawable/storage_progress" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/bookmark_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="4dp"
                    android:text="@string/drawer_bookmarks"
                    android:textAppearance="@style/TextAppearance.ZrinFile.Section" />

                <LinearLayout
                    android:id="@+id/bookmark_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/bookmark_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="长按文件夹可添加收藏"
                    android:textAppearance="@style/TextAppearance.ZrinFile.Caption"
                    android:textColor="@color/text_tertiary" />

                <LinearLayout
                    android:id="@+id/nav_container_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <View style="@style/Widget.ZrinFile.Divider" />

        <LinearLayout
            android:id="@+id/drawer_license"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_info"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="开源许可与组件"
                android:textAppearance="@style/TextAppearance.ZrinFile.Body"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="2dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:text="永久免费 · 无广告 · 无需登录"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
